{
  "expo": {
    "name": "GamerVault",
    "slug": "gamervault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gamervault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060910",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamervault.app"
    },
    "android": {
      "package": "com.gamervault.app",
      "adaptiveIcon": {
        "backgroundColor": "#060910",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060910",
          "dark": {
            "backgroundColor": "#060910"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O GamerVault usa a câmera para tirar a sua foto de perfil.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GamerVault usa a sua localização para mostrar onde você joga."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O GamerVault acessa suas fotos para você escolher capas de jogos e a foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5772cbe3-6c70-4cba-ad1e-1c03a5e1e643"
      }
    },
    "owner": "yago.64"
  }
}
